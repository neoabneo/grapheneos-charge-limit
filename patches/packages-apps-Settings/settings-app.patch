diff --git a/src/com/android/settings/fuelgauge/ChargeLimitSwitchPreference.java b/src/com/android/settings/fuelgauge/ChargeLimitSwitchPreference.java
new file mode 100644
index 0000000..ad42655
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/ChargeLimitSwitchPreference.java
@@ -0,0 +1,125 @@
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+import android.icu.text.NumberFormat;
+import android.widget.SeekBar;
+import android.widget.TextView;
+
+import androidx.preference.PreferenceViewHolder;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+
+public class ChargeLimitSwitchPreference extends SwitchPreferenceCompat
+        implements SeekBar.OnSeekBarChangeListener {
+
+    public interface OnChargeLimitChangeListener {
+        boolean onChargeLimitChange(int level);
+    }
+
+    private int mMin;
+    private int mMax;
+    private int mLevel;
+
+    private SeekBar mSeekBar;
+    private TextView mValueView;
+
+    private OnChargeLimitChangeListener mChargeLimitChangeListener;
+
+    public ChargeLimitSwitchPreference(Context context) {
+        super(context);
+        setLayoutResource(R.layout.preference_charge_limit_switch);
+        setWidgetLayoutResource(R.layout.preference_widget_switch_compat);
+    }
+
+    public void setRange(int min, int max) {
+        mMin = min;
+        mMax = max;
+
+        if (mSeekBar != null) {
+            mSeekBar.setMin(min);
+            mSeekBar.setMax(max);
+        }
+    }
+
+    public void setLevel(int level) {
+        mLevel = level;
+
+        if (mSeekBar != null && mSeekBar.getProgress() != level) {
+            mSeekBar.setProgress(level);
+        }
+
+        updateValueText(level);
+    }
+
+    public int getLevel() {
+        return mLevel;
+    }
+
+    public void setOnChargeLimitChangeListener(OnChargeLimitChangeListener listener) {
+        mChargeLimitChangeListener = listener;
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+
+        mSeekBar = (SeekBar) holder.findViewById(R.id.charge_limit_seekbar);
+        mValueView = (TextView) holder.findViewById(R.id.charge_limit_value);
+
+        mSeekBar.setMin(mMin);
+        mSeekBar.setMax(mMax);
+        mSeekBar.setProgress(mLevel);
+        mSeekBar.setOnSeekBarChangeListener(this);
+
+        updateValueText(mLevel);
+        setChargeLimitEnabled(isChecked());
+    }
+
+    public void setChargeLimitEnabled(boolean enabled) {
+        if (mSeekBar != null) {
+            mSeekBar.setEnabled(enabled);
+        }
+
+        if (mValueView != null) {
+            mValueView.setEnabled(enabled);
+        }
+    }
+
+    @Override
+    public void onProgressChanged(SeekBar seekBar, int progress, boolean fromUser) {
+        if (fromUser) {
+            updateValueText(progress);
+        }
+    }
+
+    @Override
+    public void onStartTrackingTouch(SeekBar seekBar) {}
+
+    @Override
+    public void onStopTrackingTouch(SeekBar seekBar) {
+        final int newLevel = seekBar.getProgress();
+
+        if (newLevel == mLevel) {
+            updateValueText(mLevel);
+            return;
+        }
+
+        if (mChargeLimitChangeListener != null
+                && !mChargeLimitChangeListener.onChargeLimitChange(newLevel)) {
+            seekBar.setProgress(mLevel);
+            updateValueText(mLevel);
+            return;
+        }
+
+        mLevel = newLevel;
+        updateValueText(mLevel);
+    }
+
+    private void updateValueText(int level) {
+        if (mValueView != null) {
+            mValueView.setText(
+                    NumberFormat.getPercentInstance().format(level / 100f));
+        }
+    }
+}
